{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "oz/hotspot-carousel",
  "title": "Inspiratie Hotspot Carousel",
  "description": "Carousel of project images with clickable product hotspots. Patrick can add projects, upload images, and place hotspots that link to WooCommerce products.",
  "category": "media",
  "icon": "format-gallery",
  "keywords": ["hotspot", "carousel", "inspiratie", "projects", "shoppable"],
  "textdomain": "oz-theme",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "Inspiratie"
    },
    "title": {
      "type": "string",
      "default": "Echte projecten"
    },
    "projects": {
      "type": "array",
      "default": []
    }
  },
  "supports": {
    "align": ["wide", "full"],
    "html": false,
    "anchor": true
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "viewScript": "file:./frontend.js",
  "render": "file:./render.php"
}
